#!/usr/bin/env bash
# L1 · the wrapper seam.
#
# Put this in front of whatever coding agent you run. It scans the working copy
# first and refuses to start the agent if the scan rejects, so untrusted content
# is caught before anything reads it -- not after.
#
#   agent-safe [args passed through to the agent]
#
# Configuration, all environment, no addresses:
#
#   SDLC_AGENT_BIN     the real agent executable. Required.
#   SDLC_REPO_ROOT     working copy to scan. Default: the enclosing git repo.
#   SDLC_AGENT_UNSET   space-separated env vars to unset before exec.
#                      Default: the common provider credential variables.
#
# Installation is deliberately manual and deliberately awkward. The usual move
# is to symlink this over the agent's own name so the wrapper cannot be skipped
# by habit:
#
#   mv "$(command -v <agent>)" /usr/local/bin/<agent>-real
#   ln -s /path/to/agent-safe /usr/local/bin/<agent>
#   export SDLC_AGENT_BIN=/usr/local/bin/<agent>-real
#
# Renaming the real binary out of PATH matters: if the original name still
# resolves, the wrapper is one `PATH` change away from being bypassed, which is
# the same as not having it.

set -euo pipefail

if [[ -z "${SDLC_AGENT_BIN:-}" ]]; then
  echo "[agent-safe] SDLC_AGENT_BIN is unset — refusing to guess which binary to run." >&2
  exit 2
fi

if [[ ! -x "$SDLC_AGENT_BIN" ]]; then
  echo "[agent-safe] SDLC_AGENT_BIN is not executable: $SDLC_AGENT_BIN" >&2
  exit 2
fi

# Two different questions, and conflating them is what stops this scaling:
#
#   WHERE IS THE SCANNER   next to this script, wherever the baseline is
#                          installed. One installation serves every project.
#   WHAT GETS SCANNED      the working copy you are pointing the agent at.
#
# Resolving the scanner relative to the target used to mean every project
# needed its own copy of the baseline. It is resolved relative to this script
# instead, which is normally reached through a symlink -- so the link has to be
# followed, without readlink -f, which macOS does not have.
_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
  _target="$(readlink "$_self")"
  case "$_target" in
    /*) _self="$_target" ;;
    *)  _self="$(cd "$(dirname "$_self")" && pwd)/$_target" ;;
  esac
done
BASELINE="$(cd "$(dirname "$_self")" && pwd)"
SCANNER="$BASELINE/sanitize.py"

# What to scan: an explicit override, else the enclosing git repository, else
# the current directory.
REPO="${SDLC_REPO_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"

if [[ ! -f "$SCANNER" ]]; then
  # Fail closed. A wrapper that silently degrades to a plain exec when its
  # scanner is missing is worse than no wrapper: it looks like protection.
  echo "[agent-safe] scanner not found at $SCANNER — refusing to run unscanned." >&2
  echo "[agent-safe] this wrapper resolves the scanner next to itself; if you" >&2
  echo "[agent-safe] copied agent-safe out of the baseline, symlink it instead." >&2
  exit 1
fi

# ── Stage 1 · scan ─────────────────────────────────────────────────────────
# SDLC_REPO_ROOT must be passed explicitly. The scanner otherwise derives its
# root from its own location, which -- now that the scanner lives with the
# baseline rather than with the project -- would scan the baseline and report
# the target as clean. That failure is silent and looks exactly like a pass.
if ! ( cd "$REPO" && SDLC_REPO_ROOT="$REPO" \
       python3 "$SCANNER" --trigger pre-agent-invoke --full ); then
  echo "[agent-safe] L1 REJECT — agent invocation aborted." >&2
  exit 1
fi

# ── Stage 2 · environment hygiene ──────────────────────────────────────────
# The agent should get its credentials the way it normally does. Variables
# inherited from an unrelated shell are a way for one provider's key to end up
# in another provider's request.
DEFAULT_UNSET="ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN ANTHROPIC_BASE_URL
OPENAI_API_KEY OPENAI_BASE_URL AZURE_OPENAI_API_KEY GOOGLE_API_KEY
SDLC_REVIEWER_API_KEY"

for var in ${SDLC_AGENT_UNSET:-$DEFAULT_UNSET}; do
  unset "$var" || true
done

# ── Stage 3 · exec ─────────────────────────────────────────────────────────
exec "$SDLC_AGENT_BIN" "$@"
